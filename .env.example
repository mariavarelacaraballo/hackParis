# Copia a .env y rellena. NUNCA subas .env al repo.

# Aiven PostgreSQL (memoria: residentes, notas, alertas, feedback)
PG_URI=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Aiven ClickHouse (señales y features)
CH_HOST=HOST
CH_PORT=PORT          # puerto HTTPS
CH_USER=avnadmin
CH_PASSWORD=PASSWORD

# Aiven Valkey (eventos en directo, pub/sub)
VALKEY_URI=rediss://default:PASSWORD@HOST:PORT

# Agente (Claude Platform). Solo para el agente, NO para Claude Code.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5

# OpenAI: embeddings de notas (+ transcripción opcional)
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Keenable: búsqueda web del agente (medicación, causas probables, con fuentes)
KEENABLE_API_KEY=

# ElevenLabs: voz de las alertas
ELEVENLABS_API_KEY=
VOICE_ID=

# Supabase: solo login de cuidadores y MP3 de alertas
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=alerts-audio

# Frontend permitido (CORS)
FRONTEND_ORIGIN=*
